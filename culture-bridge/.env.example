# Klucz Qloo wydany na hackathon. Bez niego aplikacja działa w trybie DEMO
# (fixture'y zamiast danych Qloo) i pokazuje o tym wyraźny baner.
# Formularz o klucz: https://forms.gle/zz12orkLHTAneLGz6
QLOO_API_KEY=

# Klucz hackathonowy działa WYŁĄCZNIE z tym hostem.
# staging.api.qloo.com i api.qloo.com zwrócą 401 dla tego klucza.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Opcjonalnie: warstwa językowa do naturalnego opisu planu.
# Bez tego plan i tak powstaje — narracja jest składana deterministycznie.
LLM_PROVIDER=none
LLM_API_KEY=

# Czas oczekiwania na Qloo (sekundy) i TTL lokalnej pamięci podręcznej.
QLOO_TIMEOUT=20
QLOO_CACHE_TTL=3600
