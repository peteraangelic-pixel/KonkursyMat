# Klucz Qloo wydany na hackathon. Bez niego aplikacja działa w trybie DEMO
# (fixture'y zamiast danych Qloo) i pokazuje o tym wyraźny baner.
# Formularz o klucz: https://forms.gle/zz12orkLHTAneLGz6
QLOO_API_KEY=

# Klucz hackathonowy działa WYŁĄCZNIE z tym hostem.
# staging.api.qloo.com i api.qloo.com zwrócą 401 dla tego klucza.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- Opcjonalna warstwa narracji (LLM) --------------------------------
# Domyślnie WYŁĄCZONA: plan i podsumowanie powstają deterministycznie,
# bez żadnego klucza. Włącza się dopiero przy kluczu ORAZ jawnym dostawcy —
# przypadkowo wklejony klucz nie zmienia zachowania aplikacji.
#
# Każda awaria tej warstwy (sieć, limit, nieznany kształt odpowiedzi) kończy
# się powrotem do narracji deterministycznej, więc demo nie pada przez LLM.
LLM_PROVIDER=none
LLM_API_KEY=

# Endpoint w formacie OpenAI-compatible. Pasuje do OpenAI, OpenRouter, Groq
# i lokalnej Ollamy — wystarczy zmienić adres.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Strojenie --------------------------------------------------------
QLOO_TIMEOUT=20
QLOO_CACHE_TTL=3600
